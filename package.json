{
  "name": "estateflow",
  "version": "1.0.0",
  "description": "EstateFlow - Enterprise Real Estate CRM Platform",
  "scripts": {
    "start": "node server/server.js",
    "server": "npm start --prefix server",
    "client": "npm start --prefix client",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "install-all": "npm install && npm install --prefix client && npm install --prefix server",
    "render-build": "npm install && npm install --prefix server && npm install --prefix client && npm run build --prefix client",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
